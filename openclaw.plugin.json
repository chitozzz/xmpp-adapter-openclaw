{
  "id": "xmpp",
  "name": "XMPP",
  "description": "XMPP/Jabber channel plugin for OpenClaw",
  "channels": ["xmpp"],
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "xmpp": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "jid": {
            "type": "string",
            "description": "Bot JID (e.g. bot@example.com)"
          },
          "password": { "type": "string" },
          "host": {
            "type": "string",
            "description": "XMPP server host (optional, auto from JID)"
          },
          "port": {
            "type": "integer",
            "default": 5222
          },
          "tls": { "type": "boolean", "default": true },
          "mucNick": {
            "type": "string",
            "description": "Nick in MUC rooms (default: localpart of JID)"
          },
          "homeChannel": {
            "type": "string",
            "description": "MUC room for cron/notifications (optional)"
          },
          "allowFrom": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Allowed bare JIDs (empty = nobody, use pairing)"
          },
          "dmSecurity": {
            "type": "string",
            "enum": ["allowlist", "pairing", "open"]
          }
        },
        "required": ["jid"]
      },
      "uiHints": {
        "jid": { "label": "JID", "help": "Bot JID, e.g. bot@example.com" },
        "password": { "label": "Password", "help": "Account password", "sensitive": true },
        "host": { "label": "Server", "help": "Optional; auto-discovered from JID" },
        "port": { "label": "Port", "help": "Default 5222" },
        "mucNick": { "label": "MUC nick", "help": "Nick in group chats" },
        "allowFrom": { "label": "Allow from", "help": "Allowed bare JIDs" }
      }
    }
  }
}
