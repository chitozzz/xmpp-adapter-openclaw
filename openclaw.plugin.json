{
  "id": "xmpp",
  "name": "XMPP",
  "description": "Custom XMPP channel plugin for OpenClaw",
  "doctorContract": {
    "configRepair": true
  },
  "activation": {
    "onStartup": true
  },
  "channels": [
    "xmpp"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "xmpp": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "enabled": { "type": "boolean" },
          "host": { "type": "string" },
          "port": { "type": "integer" },
          "tls": { "type": "boolean" },
          "jid": { "type": "string" },
          "password": { "type": "string" },
          "allowFrom": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["jid", "password"]
      }
    }
  },
  "label": "XMPP",
  "description": "XMPP channel provider for instant communication.",
  "uiHints": {
    "jid": { "label": "JID", "help": "Full XMPP JID (e.g. bot@server.com)" },
    "password": { "label": "Password", "help": "Account password" }
  }
}
